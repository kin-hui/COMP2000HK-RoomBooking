<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".BookingStatusActivity">

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/screen_booking_status" />

    <Button
        android:id="@+id/btnbackfrombookstatus"
        android:layout_width="99dp"
        android:layout_height="55dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="760dp"
        android:alpha="0"
        android:text="Button"
        app:layout_constraintBottom_toTopOf="@+id/btnhomefrombookstatus2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnlogoutfrombookstatus"
        android:layout_width="97dp"
        android:layout_height="55dp"
        android:layout_marginTop="19dp"
        android:layout_marginEnd="18dp"
        android:alpha="0"
        android:text="Button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnmybookingfrombookstatus"
        android:layout_width="358dp"
        android:layout_height="64dp"
        android:layout_marginStart="160dp"
        android:layout_marginTop="509dp"
        android:layout_marginEnd="160dp"
        android:layout_marginBottom="279dp"
        android:alpha="0"
        android:text="Button"
        app:layout_constraintBottom_toTopOf="@+id/btnsearchfromroomstatus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnhomefrombookstatus"
        android:layout_width="359dp"
        android:layout_height="51dp"
        android:layout_marginStart="27dp"
        android:layout_marginTop="574dp"
        android:layout_marginEnd="27dp"
        android:alpha="0"
        android:text="Button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.666"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnhomefrombookstatus2"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginEnd="9dp"
        android:alpha="0"
        android:text="Button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnsearchfromroomstatus"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnbackfrombookstatus" />

    <Button
        android:id="@+id/btnsearchfromroomstatus"
        android:layout_width="0dp"
        android:layout_height="69dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="4dp"
        android:alpha="0"
        android:text="Button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnmybookingfrombookstatus2"
        app:layout_constraintStart_toEndOf="@+id/btnhomefrombookstatus2" />

    <Button
        android:id="@+id/btnmybookingfrombookstatus2"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_marginEnd="9dp"
        android:layout_marginBottom="8dp"
        android:alpha="0"
        android:text="Button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnsearchfromroomstatus" />
</androidx.constraintlayout.widget.ConstraintLayout>